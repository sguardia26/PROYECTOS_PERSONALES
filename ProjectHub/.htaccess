Options -Indexes -MultiViews

<FilesMatch "(^\.|\.(bak|config|sql|fla|psd|ini|log|sh|env|md)$)">
    Order allow,deny
    Deny from all
</FilesMatch>

<IfModule mod_headers.c>
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /ProjectHub/
    RewriteCond %{QUERY_STRING} (\.\./|\.\.\\) [NC,OR]
    RewriteCond %{QUERY_STRING} (<|%3C).*script.*(>|%3E) [NC,OR]
    RewriteCond %{QUERY_STRING} (UNION.*SELECT|SELECT.*FROM|INSERT.*INTO|DELETE.*FROM|DROP.*TABLE) [NC,OR]
    RewriteCond %{QUERY_STRING} (concat.*\(|base64_decode|eval\(|benchmark\() [NC]
    RewriteRule ^.*$ - [F,L]
</IfModule>

<IfModule mod_mime.c>
    AddType application/manifest+json .json
    AddType application/vnd.android.package-archive .apk
    AddType font/woff2 .woff2
    AddType font/woff .woff
</IfModule>
